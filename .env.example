# Copy to .env.local (gitignored). Public values only — server secrets
# (BETTER_AUTH_SECRET, RESEND_API_KEY, OAuth secrets) go on the Convex
# deployment with `npx convex env set NAME=value`, never in this file.
# `npx convex dev` writes the first two lines for you. See docs/SETUP.md.

CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
# Optional — derived from NEXT_PUBLIC_CONVEX_URL if unset.
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only after launch (see docs/ONBOARDING.md).
# NEXT_PUBLIC_LAUNCH_MODE=open
